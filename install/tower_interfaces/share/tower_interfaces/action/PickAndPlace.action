# OBJECTIF : supervisor_node -> manipulation_node.
# La pose source est piece.pose : centre de l'objet avant la saisie.
tower_interfaces/Piece piece

# Pose desiree du CENTRE de l'objet apres la depose.
# Ce n'est pas la pose de la pince : manipulation_node calcule le decalage.
# Le serveur transforme les poses vers son repere de planification avec TF.
geometry_msgs/PoseStamped place_pose
---
# RESULTAT : manipulation_node -> supervisor_node.
# true = sequence executee ; le superviseur doit encore verifier le placement.
bool success
string message
---
# PROGRESSION : etape courante de la manipulation.
uint8 APPROACHING=0
uint8 GRASPING=1
uint8 LIFTING=2
uint8 TRANSPORTING=3
uint8 PLACING=4
uint8 RETREATING=5

uint8 stage
string detail
